    let temp: Number = arg1 + 54;

    typeswitch (receiver) {
        case (n: Number): {
            result = n + temp;
        }
        case (s: String): {
            result = 54;
        }
        case (o: JSObject): {
            result = o.length;
        }
    }

    while (result < 100) {
        result = result + 1;
        if (result == 50) {
            continue;
        }
        if (result > 75) {
            break;
        }
    }

    return result > 0 ? result : 0;
}

