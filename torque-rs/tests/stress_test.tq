javascript builtin TestBuiltin0(context: Context, receiver: JSAny, arg1: Number, arg2: String): JSAny {
    let result: Number = 0;
    let temp: Number = arg1 + 0;

    typeswitch (receiver) {
        case (n: Number): {
            result = n + temp;
        }
        case (s: String): {
            result = 0;
        }
        case (o: JSObject): {
            result = o.length;
        }
    }

    while (result < 100) {
        result = result + 1;
        if (result == 50) {
            continue;
        }
        if (result > 75) {
            break;
        }
    }

    return result > 0 ? result : 0;
}

